# Public client configuration only.
# Vite exposes VITE_* values to browser JavaScript. Never put secrets here.

# Optional: override the public Arbitrum Sepolia RPC endpoint.
VITE_ARBITRUM_SEPOLIA_RPC_URL=

# Required for passkey + sponsored transaction testing.
VITE_ZERODEV_PROJECT_ID=

# Optional explicit WebAuthn relying-party ID.
# For the stable testnet domain, set this deliberately to the RP ID configured
# for https://arbitrum-testnet.proofstamp.org/.
# For isolated *.pages.dev previews, leave blank only when you intentionally
# want the wallet/browser to use the current preview hostname behavior.
VITE_ZERODEV_RP_ID=
