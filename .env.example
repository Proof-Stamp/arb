# Public client configuration only.
# Vite exposes VITE_* values to browser JavaScript. Never put secrets here.
# Optional: override the public Arbitrum Sepolia RPC endpoint.
VITE_ARBITRUM_SEPOLIA_RPC_URL=
# Required for passkey + sponsored transaction testing.
VITE_ZERODEV_PROJECT_ID=
# Optional. Leave blank on temporary pages.dev previews so the current hostname is used.
# Set deliberately before production users create passkeys.
VITE_ZERODEV_RP_ID=
